# Copy to .env for `docker compose` (the file is gitignored).
#
# Bundled MongoDB and Chroma are used by default. Leave the service URLs
# commented out for the single-command self-hosted setup.

# --- required ---------------------------------------------------------------
GROQ_API_KEY=gsk_replace_me
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters

# --- public URL / reverse proxy --------------------------------------------
# APP_PORT=5000
# Only set when Caddy/Nginx is in front of the app.
# TRUST_PROXY=true
# Comma-separated extra browser origins, if the frontend is on another domain.
# CORS_ORIGINS=https://schemes.example.com

# --- external services (optional) ------------------------------------------
# MONGODB_URI=mongodb+srv://user:password@cluster/schemesaathi?retryWrites=true&w=majority
# MONGODB_DB=schemesaathi
# CHROMA_URL=https://chroma.example.com:443
# CHROMA_COLLECTION=schemes
# DISABLE_CHROMA=false
# SCHEME_EMBEDDINGS_FILE=/app/data/scheme_embeddings.json
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- retrieval tuning (optional) --------------------------------------------
# Hybrid retrieval is enabled by default. Dense and BM25 candidates are fused
# with reciprocal-rank fusion; the lexical weight is intentionally higher.
# HYBRID_RETRIEVAL=true
# HYBRID_CANDIDATES=25
# HYBRID_RRF_K=60
# HYBRID_DENSE_WEIGHT=0.6
# HYBRID_LEXICAL_WEIGHT=1.4

# --- data refresh (destructive, opt-in) ------------------------------------
# SEED_FORCE=true
# EMBED_FORCE=true
