# --- required ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/schemesaathi?retryWrites=true&w=majority
MONGODB_DB=schemesaathi
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET=replace-with-a-long-random-string

# --- optional ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Set to true only when running behind Caddy/Nginx/a load balancer so req.ip
# and rate limiting see the real client address.
TRUST_PROXY=false
# Override only if the built SPA is not at ../frontend/dist.
# FRONTEND_DIST=/app/frontend/dist
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000

# Vector store (run `npm run chroma` in another terminal)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=schemes
# Set true on serverless hosts that cannot reach Chroma; retrieval then uses
# the in-process BM25 index.
DISABLE_CHROMA=false

# Retrieval defaults
TOP_K=3
MAX_TOP_K=10

# Comma-separated list of allowed browser origins. A production deployment
# served from the same origin as the API does not need this.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Abuse protection for the AI and auth endpoints
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# RATE_LIMIT_DISABLED=true

JWT_EXPIRES_IN=7d

# --- first-run seeding (containers) ----------------------------------------
# SEED_FORCE=true      replace the schemes collection from data/schemes.json
# EMBED_FORCE=true     rebuild the Chroma collection even if counts match
