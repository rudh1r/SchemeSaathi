{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__schemesaathi_path="
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__schemesaathi_path=$1"
    }
  ]
}
